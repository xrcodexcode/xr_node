# XR-NODES Agent OS Configuration
# Copy this file to .env and fill in your values

# Server
XR_HOST=127.0.0.1
XR_PORT=8000
XR_ENVIRONMENT=development
XR_DEBUG=true
XR_LOG_LEVEL=INFO

# Vault (defaults to parent directory of xr-nodes-agent-os)
# XR_VAULT_PATH=C:\Users\offic\OneDrive\Desktop\obsidean\nexusdb

# Database (relative to xr-nodes-agent-os/)
# XR_DATABASE_URL=sqlite+aiosqlite:///./data/xr-nodes.db

# Model Providers (add your API keys)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# OLLAMA_BASE_URL=http://localhost:11434
