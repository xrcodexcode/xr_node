# =============================================================================
# LightRAG server configuration for NexusDB
# Generated: 2026-08-08
# Docs: https://github.com/HKUDS/LightRAG
# =============================================================================
# This file is consumed by the LightRAG server (lightrag-server command).
# It is intentionally gitignored — see .gitignore rule below.
# =============================================================================

# ---- Server bind ------------------------------------------------------------
HOST=127.0.0.1
PORT=9621

# WebUI mount path (default /webui). Set empty to disable.
WEBUI_TITLE=NexusDB LightRAG

# ---- Auth (set AUTH_ACCOUNTS or LIGHTRAG_API_KEY before exposing) ----------
# LIGHTRAG_API_KEY=change-me
# AUTH_ACCOUNTS=admin:$2b$12$<bcrypt-hash>
# TOKEN_SECRET=<random-string>
# WHITELIST_PATHS=/health

# ---- LLM backend (OLLAMA) ---------------------------------------------------
# Local Ollama. Defaults chosen from models actually present in this vault's
# ~/.ollama/models. Override by exporting these in your shell, or editing here.
#
# Switching to a hosted provider: change LLM_BINDING to openai / anthropic /
# gemini and supply the matching *_API_KEY. No code change required.
LLM_BINDING=ollama
LLM_BINDING_HOST=http://localhost:11434
LLM_CONTEXT_WINDOW=8192
LLM_MAX_TOKENS=2048

# Role-specific models — LightRAG recommends separate, fast models per role.
#   EXTRACT  — runs on every chunk; must be non-thinking, fast
#   QUERY    — writes the final answer; stronger model preferred
#   KEYWORD  — short keyword extraction; must be non-thinking, low latency
#   VLM      — multimodal (only used if you enable VLM processing)
#
# On CPU-only boxes, gemma2:2b takes ~4s/token — extraction can exceed the
# 240s default timeout. EXTRACT_LLM_TIMEOUT below is set to 30 min to absorb
# this. If you switch to GPU or a faster model, lower it.
EXTRACT_LLM_BINDING=ollama
EXTRACT_LLM_MODEL=qwen3.5:2b
EXTRACT_LLM_TIMEOUT=1800
QUERY_LLM_BINDING=ollama
QUERY_LLM_MODEL=qwen3.5:2b
QUERY_LLM_TIMEOUT=600
KEYWORD_LLM_BINDING=ollama
KEYWORD_LLM_MODEL=qwen3.5:2b
KEYWORD_LLM_TIMEOUT=1800

# ---- Embedding backend ------------------------------------------------------
EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BINDING_HOST=http://localhost:11434

# ---- Storage (default file-backed; swap to postgres/neo4j/milvus later) ----
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage

# Working directory for KV/Vector/Graph files. Absolute path recommended.
# Use Windows-native backslash paths on Windows (LightRAG runs os.path.abspath).
WORKING_DIR=C:\Users\offic\OneDrive\Desktop\obsidean\nexusdb\lightrag-server\data

# ---- Reranker ---------------------------------------------------------------
# LightRAG has a built-in reranker. Set RERANK_BINDING=null to disable.
# Local reranker is slow on small models; disable to speed up first ingest.
RERANK_BINDING=null

# ---- Chunking ---------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
CHUNK_TOKENIZER=tiktoken

# ---- Document processing pipeline ------------------------------------------
# Use the native parser (no external MinerU/Docling service needed for md files).
LIGHTRAG_PARSER=*:native

# ---- Misc -------------------------------------------------------------------
SUMMARY_LANGUAGE=English
ENABLE_LLM_CACHE=true
ENABLE_CONTENT_HEADINGS=true
MAX_ASYNC=4
MAX_PARALLEL_INSERT=1
EMBEDDING_FUNC_MAX_ASYNC=4
EMBEDDING_BATCH_NUM=16

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=C:\Users\offic\OneDrive\Desktop\obsidean\nexusdb\lightrag-server\logs
