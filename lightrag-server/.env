# =============================================================================
# LightRAG server configuration for NexusDB
# Generated: 2026-08-08
# Docs: https://github.com/HKUDS/LightRAG
# =============================================================================
# This file is consumed by the LightRAG server (lightrag-server command).
# It is intentionally gitignored — see .gitignore rule below.
# =============================================================================

# ---- Server bind ------------------------------------------------------------
HOST=127.0.0.1
PORT=9621

# WebUI mount path (default /webui). Set empty to disable.
WEBUI_TITLE=NexusDB LightRAG

# ---- Auth (set AUTH_ACCOUNTS or LIGHTRAG_API_KEY before exposing) ----------
# LIGHTRAG_API_KEY=change-me
# AUTH_ACCOUNTS=admin:$2b$12$<bcrypt-hash>
# TOKEN_SECRET=<random-string>
# WHITELIST_PATHS=/health

# ---- LLM backend (OLLAMA) ---------------------------------------------------
# Local Ollama. Defaults chosen from models actually present in this vault's
# ~/.ollama/models. Override by exporting these in your shell, or editing here.
#
# Switching to a hosted provider: change LLM_BINDING to openai / anthropic /
# gemini and supply the matching *_API_KEY. No code change required.
LLM_BINDING=ollama
LLM_BINDING_HOST=http://localhost:11434
LLM_MODEL=gemma2:2b


# ---- Ollama runtime mode ---------------------------------------------
# On this vault's Windows host the AMD ROCm detection watchdog times
# out (see HOME-BASE.md / CLAUDE.md) and Ollama hangs on the first
# /api/chat call. Forcing OLLAMA_LLM_LIBRARY=cpu skips the ROCm probe
# entirely. Other "disable GPU" flags (OLLAMA_NUM_GPU=0, etc.) are
# NOT enough — the ROCm library is still loaded at startup. Remove
# this once you have a working GPU stack.
OLLAMA_LLM_LIBRARY=cpu
OLLAMA_NUM_GPU=0
LLM_CONTEXT_WINDOW=8192
# LLM_MAX_TOKENS is a no-op for the Ollama backend (lightrag pops and
# discards it). The real per-response budget for Ollama is set by
# OLLAMA_LLM_NUM_PREDICT further down.
# LLM_MAX_TOKENS=4096

# ---- Role-specific models — LightRAG recommends separate, fast models per role.
#   EXTRACT  — runs on every chunk; must be non-thinking, fast
#   QUERY    — writes the final answer; stronger model preferred
#   KEYWORD  — short keyword extraction; must be non-thinking, low latency
#   VLM      — multimodal (only used if you enable VLM processing)
#
# On CPU-only boxes, gemma2:2b takes ~4s/token — extraction can exceed the
# 240s default timeout. EXTRACT_LLM_TIMEOUT below is set to 30 min to absorb
# this. If you switch to GPU or a faster model, lower it.
EXTRACT_LLM_BINDING=ollama
EXTRACT_LLM_MODEL=gemma2:2b
EXTRACT_LLM_TIMEOUT=1800
QUERY_LLM_BINDING=ollama
QUERY_LLM_MODEL=gemma2:2b
QUERY_LLM_TIMEOUT=600
KEYWORD_LLM_BINDING=ollama
KEYWORD_LLM_MODEL=gemma2:2b
KEYWORD_LLM_TIMEOUT=1800

# Force JSON extraction mode for Ollama/small models
# Prevents delimiter format errors (e.g. 3/5 fields on RELATION) on small models
ENTITY_EXTRACTION_USE_JSON=true


# ---- Ollama LLM generation options (per-role) ---------------------------
# These go into the Ollama `options` block of every /api/chat call. The
# LightRAG defaults are num_predict=128 and num_ctx=32768 — both are wrong
# for qwen3.5:2b on a vault chunk:
#   * num_predict=128 truncates the JSON extraction almost immediately
#     (done_reason=length → "Complete delimiter not found" → 0 entities)
#   * num_ctx=32768 is way over the 8k context this CPU box can serve fast
# We pin num_predict=4096 (room for thinking + JSON) and num_ctx=8192 (fast
# enough on CPU, large enough for our chunks). Lower both if you switch to
# a GPU or a non-thinking model.
EXTRACT_OLLAMA_LLM_NUM_PREDICT=4096
EXTRACT_OLLAMA_LLM_NUM_CTX=8192
EXTRACT_OLLAMA_LLM_TEMPERATURE=0.1
QUERY_OLLAMA_LLM_NUM_PREDICT=4096
QUERY_OLLAMA_LLM_NUM_CTX=8192
QUERY_OLLAMA_LLM_TEMPERATURE=0.1
KEYWORD_OLLAMA_LLM_NUM_PREDICT=2048
KEYWORD_OLLAMA_LLM_NUM_CTX=8192
KEYWORD_OLLAMA_LLM_TEMPERATURE=0.1

# Note on qwen3.5:2b "thinking" mode: Ollama's chat API has a top-level
# `think` flag (true/false). LightRAG's binding_options dataclass does not
# expose it, so we cannot set it from .env alone. With num_predict=4096
# we leave headroom for the thinking block + JSON; if you still see
# `done_reason=length` in logs, the chunk is too long for one call and you
# should drop CHUNK_SIZE (below) or pick a non-thinking model such as
# gemma2:2b.

# ---- Embedding backend ------------------------------------------------------
EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BINDING_HOST=http://localhost:11434

# ---- Storage (default file-backed; swap to postgres/neo4j/milvus later) ----
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage

# Working directory for KV/Vector/Graph files.
WORKING_DIR=./data
INPUT_DIR=./inputs

# ---- Reranker ---------------------------------------------------------------
# LightRAG has a built-in reranker. Set RERANK_BINDING=null to disable.
# Local reranker is slow on small models; disable to speed up first ingest.
RERANK_BINDING=null

# ---- Chunking ---------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
CHUNK_TOKENIZER=tiktoken

# ---- Document processing pipeline ------------------------------------------
# Use the native parser (no external MinerU/Docling service needed for md files).
LIGHTRAG_PARSER=*:native

# ---- Misc -------------------------------------------------------------------
SUMMARY_LANGUAGE=English
ENABLE_LLM_CACHE=true
ENABLE_CONTENT_HEADINGS=true
MAX_ASYNC=1
MAX_PARALLEL_INSERT=1
EMBEDDING_FUNC_MAX_ASYNC=4
EMBEDDING_BATCH_NUM=16

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs

